        "temporal_pooling": "60-second mean pooling (12 x 5s windows)",
        "normalization": "L2 Vector Normalization"
    },
    "models": {
        "final_model": "Zero-Shot Geometric Retrieval",
        "retrieval_mechanism": "Class-wise Maximum Cosine Similarity",
