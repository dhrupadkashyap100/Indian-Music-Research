        "instances": 53,
        "role": "Independent Test Domain"
    },
    "folk_dataset": {
        "target_files": 328,
        "processed_files": 327,
        "genres": 10
    },
    "preprocessing": {
        "sampling_rate": 24000,
        "channels": "Mono",
